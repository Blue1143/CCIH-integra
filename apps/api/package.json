{
  "name": "@ccih/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API do CCIH Integra: autenticação, autorização (RBAC + escopo por setor), auditoria imutável e configurações.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/cli.ts migrate",
    "db:reset": "tsx --env-file-if-exists=.env src/db/cli.ts reset",
    "db:seed": "tsx --env-file-if-exists=.env src/db/cli.ts seed",
    "audit:verify": "tsx --env-file-if-exists=.env src/db/cli.ts verify-audit",
    "admin:bootstrap": "tsx --env-file-if-exists=.env src/cli/bootstrap-admin.ts",
    "attachments": "tsx --env-file-if-exists=.env src/cli/attachments.ts",
    "org:create": "tsx --env-file-if-exists=.env src/cli/create-organization.ts"
  },
  "dependencies": {
    "@ccih/demo-data": "0.1.0",
    "@ccih/domain": "0.1.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "10.3.0",
    "argon2": "0.44.0",
    "fastify": "5.12.7",
    "kysely": "0.28.17",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "esbuild": "0.25.12",
    "tsx": "4.23.15"
  }
}
