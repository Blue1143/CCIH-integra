# Copie para apps/api/.env (ignorado pelo git). Nunca versione valores reais.
# Dois papéis no PostgreSQL: o "owner" roda migrações; o "app" só tem DML (sem DDL, sem UPDATE/DELETE no audit_log).
DATABASE_URL=postgres://ccih_app:TROQUE@localhost:5432/ccih_dev
DATABASE_OWNER_URL=postgres://ccih_owner:TROQUE@localhost:5432/ccih_dev
# Banco exclusivo para os testes de integração (é apagado e recriado a cada execução).
TEST_DATABASE_URL=postgres://ccih_app:TROQUE@localhost:5432/ccih_test
TEST_DATABASE_OWNER_URL=postgres://ccih_owner:TROQUE@localhost:5432/ccih_test

# Origem exata do front-end (verificação de Origin contra CSRF).
APP_ORIGIN=http://localhost:5173
PORT=3001
HOST=127.0.0.1

# Sessão e bloqueio de conta
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Validade da senha local em dias (0 = sem expiração). Vencida, o usuário troca a senha no próximo acesso.
PASSWORD_MAX_AGE_DAYS=0

# Chave (32 bytes em base64) para cifrar o nome completo de pacientes. Sem ela, só iniciais + prontuário.
# Gere localmente (não versione): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEY=

# Anexos (PDF, PNG ou JPEG): pasta fora da raiz web, criada com permissão restrita, e tamanho máximo por arquivo.
UPLOAD_DIR=var/uploads
UPLOAD_MAX_MB=5

# Armazenamento dos anexos: local (UPLOAD_DIR) ou s3 (S3, MinIO ou o armazenamento de objetos do provedor).
# Credenciais só por variável de ambiente ou cofre de segredos; nunca no repositório.
ATTACHMENT_STORAGE=local
# S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# S3_REGION=sa-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_SERVER_SIDE_ENCRYPTION=AES256

# Cifragem dos anexos na aplicação (AES-256-GCM), obrigatória em produção. Gere a chave localmente e guarde no cofre:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Na troca de chave, a anterior vai para ATTACHMENT_ENCRYPTION_PREVIOUS_KEYS ("id:base64;id:base64") até a recifragem.
# ATTACHMENT_ENCRYPTION_KEY=
# ATTACHMENT_ENCRYPTION_KEY_ID=
# ATTACHMENT_ENCRYPTION_PREVIOUS_KEYS=

# Antivírus: off (arquivos ficam "não verificados", sinalizados) ou clamav (clamd; o arquivo só é liberado depois de "limpo").
ANTIVIRUS=off
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=15000

# Tempo real: sse (telas atualizadas no momento do registro) ou polling (só atualização periódica,
# para infraestrutura que não mantém conexões abertas). Intervalo do modo periódico, retenção dos eventos
# para reconexão e limite de conexões por instância da API. O proxy precisa permitir SSE sem buffer.
REALTIME_MODE=sse
REALTIME_POLL_SECONDS=60
REALTIME_RETENTION_HOURS=24
REALTIME_MAX_CONNECTIONS=500

# true em produção (HTTPS). false apenas em desenvolvimento local sem TLS.
COOKIE_SECURE=false
# true quando atrás de proxy reverso confiável (para registrar o IP real no log de auditoria).
TRUST_PROXY=false

# Opcional, só para testes/E2E: senha única dos usuários de demonstração do seed.
# SEED_PASSWORD=
