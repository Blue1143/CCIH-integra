# Proxy de entrada: HTTPS automático (Let's Encrypt) para SITE_ADDRESS, arquivos da web e /api encaminhado à API.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		# flush_interval -1: atualizações em tempo real (SSE) sem buffer.
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Arquivos com hash no nome podem ficar em cache; index.html nunca.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@index path / /index.html
		header @index Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
