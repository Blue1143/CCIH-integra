# Copie para deploy/.env no servidor (o arquivo é ignorado pelo git). Nunca versione valores reais.
# Gere cada segredo no próprio servidor, por exemplo:
#   openssl rand -hex 24                      (senhas do banco: só letras e números)
#   openssl rand -base64 32                   (chaves de cifragem: 32 bytes em base64)

# Endereço público (DNS apontando para este servidor). O Caddy emite o certificado HTTPS sozinho.
SITE_ADDRESS=ccih.exemplo.com.br
# Origem exata usada pelo navegador (proteção contra CSRF): https:// + SITE_ADDRESS.
APP_ORIGIN=https://ccih.exemplo.com.br

# Banco (dois papéis: o dono roda migrações; a aplicação só lê e grava dados).
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Cifragem dos anexos (obrigatória em produção). Guarde também fora do servidor: sem ela os anexos não abrem.
ATTACHMENT_ENCRYPTION_KEY=
ATTACHMENT_ENCRYPTION_KEY_ID=k1
# ATTACHMENT_ENCRYPTION_PREVIOUS_KEYS=

# Opcional: cifragem do nome completo de pacientes (modelo hospitalar). Sem ela, só iniciais + prontuário.
# FIELD_ENCRYPTION_KEY=

# Anexos: local (volume "uploads") ou s3 (armazenamento de objetos compatível com S3).
ATTACHMENT_STORAGE=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Antivírus: off ou clamav (suba com --profile antivirus).
ANTIVIRUS=off

# Sessão e senhas
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
PASSWORD_MAX_AGE_DAYS=0
